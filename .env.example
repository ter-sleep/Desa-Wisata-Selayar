# Ambil Project URL dan Publishable key dari Supabase Dashboard > Project Settings > API.
# Salin file ini menjadi .env.local lalu isi kedua nilai tersebut.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jangan menambahkan service_role key ke frontend.
# Fondasi Tahap 2 memakai Publishable key + Row Level Security (RLS).
